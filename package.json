    "check:adsense": "node scripts/adsense-readiness.mjs",
    "check:headers": "node scripts/build-headers.mjs",
    "lint:policy": "node scripts/adsense-policy-lint.mjs",
    "reverify:claims": "node scripts/reverify-claims.mjs",
    "ingest:youth": "node scripts/ingest-youth-policies.mjs",
