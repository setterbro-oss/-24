  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-headers.mjs && node scripts/validate-data.mjs && npm run lint:policy && astro build && node scripts/verify-build.mjs",
    "preview": "astro preview",
    "check:data": "node scripts/validate-data.mjs",
    "check:freshness": "node scripts/check-freshness.mjs",
    "verify:build": "node scripts/verify-build.mjs",
