---
interface Props {
  regionName: string;
  monthlyLimit: number;
  depositLimit: number;
}

const { regionName, monthlyLimit, depositLimit } = Astro.props;
---

<div class="calc-card">
  <div class="badge">모의 계산기</div>
  <h3>📊 {regionName} 청년 월세지원 수령액 즉시 계산</h3>
  <p class="desc">현재 납부 중인 임차보증금과 월세를 입력하면 예상 수령액을 진단합니다.</p>

  <div class="form-grid">
    <div class="field">
      <label for="input-deposit">임차 보증금 (원)</label>
      <input type="number" id="input-deposit" placeholder="예: 10000000" value="10000000" />
    </div>
    <div class="field">
      <label for="input-rent">매월 납부 월세 (원)</label>
      <input type="number" id="input-rent" placeholder="예: 450000" value="450000" />
    </div>
  </div>

  <div class="result-box">
    <div class="res-item">
      <span>월 예상 지원금:</span>
      <strong id="res-monthly" class="highlight">-</strong>
    </div>
    <div class="res-item">
      <span>12개월 총 수령 예상액:</span>
      <strong id="res-total">-</strong>
    </div>
    <div id="res-status" class="res-note">계산 중...</div>
  </div>
</div>

<script define:vars={{ monthlyLimit, depositLimit }}>
  function calc() {
    const deposit = Number(document.getElementById('input-deposit')?.value || 0);
    const rent = Number(document.getElementById('input-rent')?.value || 0);
    const resMonthly = document.getElementById('res-monthly');
    const resTotal = document.getElementById('res-total');
    const resStatus = document.getElementById('res-status');

    if (deposit > depositLimit) {
      resMonthly.innerText = '0 원';
      resTotal.innerText = '0 원';
      resStatus.innerText = `⚠️ 보증금 기준(${depositLimit.toLocaleString()}원 이하)을 초과하여 지원 대상에서 제외될 수 있습니다.`;
      resStatus.style.color = '#EF4444';
      return;
    }

    const payable = Math.min(rent, monthlyLimit);
    resMonthly.innerText = payable.toLocaleString() + ' 원';
    resTotal.innerText = (payable * 12).toLocaleString() + ' 원';
    resStatus.innerText = `✅ 기준 충족 시 매월 ${payable.toLocaleString()}원씩 최대 12회 지급됩니다.`;
    resStatus.style.color = '#10B981';
  }

  document.getElementById('input-deposit')?.addEventListener('input', calc);
  document.getElementById('input-rent')?.addEventListener('input', calc);
  calc();
</script>

<style>
  .calc-card {
    background: #111827;
    border: 1px solid #1F2937;
    border-radius: 12px;
    padding: 1.5rem;
    margin: 2rem 0;
  }
  .badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    color: #10B981;
    background: rgba(16, 185, 129, 0.1);
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    margin-bottom: 0.5rem;
  }
  .calc-card h3 { margin: 0 0 0.5rem; font-size: 1.2rem; }
  .desc { font-size: 0.85rem; color: #9CA3AF; margin-bottom: 1.2rem; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem; }
  .field label { display: block; font-size: 0.8rem; color: #D1D5DB; margin-bottom: 0.3rem; }
  .field input {
    width: 100%;
    padding: 0.6rem;
    background: #0B0F19;
    border: 1px solid #374151;
    color: #fff;
    border-radius: 6px;
    box-sizing: border-box;
  }
  .result-box {
    background: #0B0F19;
    border: 1px solid #1F2937;
    border-radius: 8px;
    padding: 1rem;
    margin-top: 1rem;
  }
  .res-item { display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.9rem; }
  .highlight { color: #10B981; font-size: 1.1rem; }
  .res-note { font-size: 0.8rem; margin-top: 0.5rem; border-top: 1px solid #1F2937; padding-top: 0.5rem; }
</style>
