---
interface Props {
  title: string;
  monthlyLimit: number;
  maxMonths: number;
}
const { title, monthlyLimit, maxMonths } = Astro.props;
const fmt = (value: number) => new Intl.NumberFormat('ko-KR').format(value);
---
<section class="calc-card" data-calc data-monthly-limit={monthlyLimit} data-max-months={maxMonths} aria-labelledby="calc-title">
  <p class="eyebrow">참고용 산술 계산기</p>
  <h2 id="calc-title">{title}</h2>
  <p class="desc">월세와 월 한도({fmt(monthlyLimit)}원) 중 작은 금액에 개월 수를 곱한 단순 계산입니다. 자격 심사와 선정 여부는 반영하지 않으며 실제 지급액을 뜻하지 않습니다.</p>
  <div class="form-grid">
    <div class="field">
      <label for="rent-input">월 임차료 (원)</label>
      <input id="rent-input" type="number" inputmode="numeric" min="0" max="100000000" step="1000" value="450000" />
    </div>
    <div class="field">
      <label for="months-input">계산 기간 (1~{maxMonths}개월)</label>
      <input id="months-input" type="number" inputmode="numeric" min="1" max={maxMonths} step="1" value={Math.min(12, maxMonths)} />
    </div>
  </div>
  <div class="result-box" aria-live="polite" aria-atomic="true">
    <div class="res-item"><span>월 지원 상한 적용 금액</span><strong data-out="monthly">-</strong></div>
    <div class="res-item"><span>선택 기간 단순 합계</span><strong data-out="total">-</strong></div>
    <p class="res-note" data-out="message">입력값을 확인하고 있습니다.</p>
  </div>
</section>
<script>
  import { calculateSupport, formatWon } from '../lib/calc.mjs';

  document.querySelectorAll('[data-calc]').forEach((root) => {
    const monthlyLimit = Number(root.dataset.monthlyLimit);
    const maxMonths = Number(root.dataset.maxMonths);
    const rentInput = root.querySelector('#rent-input');
    const monthsInput = root.querySelector('#months-input');
    const outMonthly = root.querySelector('[data-out="monthly"]');
    const outTotal = root.querySelector('[data-out="total"]');
    const outMessage = root.querySelector('[data-out="message"]');

    function run() {
      const result = calculateSupport({
        rent: Number(rentInput.value),
        months: Number(monthsInput.value),
        monthlyLimit,
        maxMonths,
      });
      if (!result.ok) {
        outMonthly.textContent = '입력 확인';
        outTotal.textContent = '입력 확인';
        outMessage.textContent = result.error;
        return;
      }
      outMonthly.textContent = formatWon(result.monthly);
      outTotal.textContent = formatWon(result.total);
      outMessage.textContent = '단순 산술 결과입니다. 실제 지원금이나 수급 자격을 뜻하지 않습니다.';
    }

    rentInput.addEventListener('input', run);
    monthsInput.addEventListener('input', run);
    run();
  });
</script>
<style>
  .calc-card { margin: 2rem 0; padding: clamp(1rem, 4vw, 1.5rem); border: 1px solid #293548; border-radius: 14px; background: #111827; }
  .eyebrow { margin: 0 0 .3rem; color: #34d399; font-size: .8rem; font-weight: 800; }
  .calc-card h2 { margin: 0 0 .5rem; font-size: 1.35rem; }
  .desc { color: #c1cad7; font-size: .92rem; }
  .form-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 1.2rem 0; }
  .field label { display: block; margin-bottom: .35rem; font-size: .9rem; }
  .field input { width: 100%; min-height: 44px; padding: .65rem; border: 1px solid #526078; border-radius: 7px; background: #0b0f19; color: #fff; font: inherit; }
  .result-box { min-height: 150px; padding: 1rem; border-radius: 9px; background: #0b0f19; border: 1px solid #293548; }
  .res-item { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; }
  .res-item strong { color: #34d399; text-align: right; }
  .res-note { margin: .5rem 0 0; padding-top: .7rem; border-top: 1px solid #293548; color: #d1d5db; font-size: .85rem; }
  @media (max-width: 520px) { .form-grid { grid-template-columns: 1fr; } .res-item { flex-direction: column; gap: .15rem; } .res-item strong { text-align: left; } }
</style>
