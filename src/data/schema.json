{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouthRent24 verified policy record",
  "type": "object",
  "required": [
    "name",
    "sourceUrl",
    "sourceTitle",
    "verificationStatus",
    "verifiedAt",
    "effectiveFrom",
    "facts",
    "verificationReport"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 2
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "sourceTitle": {
      "type": "string",
      "minLength": 4
    },
    "noticeId": {
      "type": "string",
      "minLength": 1
    },
    "verificationStatus": {
      "enum": [
        "unverified",
        "verified"
      ]
    },
    "verifiedAt": {
      "type": "string",
      "format": "date"
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date"
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "facts": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      }
    },
    "verificationReport": {
      "type": "object",
      "required": [
        "allClaimsMatch",
        "sourceUrl",
        "checkedAt",
        "snapshotHash",
        "claims"
      ],
      "properties": {
        "allClaimsMatch": {
          "const": true
        },
        "claims": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "value",
              "unit",
              "anchor",
              "sourceSnippet",
              "verifiedAt",
              "status"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "value": {},
              "unit": {
                "type": "string"
              },
              "anchor": {
                "type": "string"
              },
              "sourceSnippet": {
                "type": "string"
              },
              "verifiedAt": {
                "type": "string",
                "format": "date"
              },
              "status": {
                "enum": [
                  "matched",
                  "changed",
                  "conflict",
                  "unreachable"
                ]
              }
            }
          }
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "snapshotHash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    }
  }
}
