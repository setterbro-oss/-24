---
import Layout from '../layouts/Layout.astro';
import regionsData from '../data/regions.json';

const siteUrl = Astro.site ? Astro.site.origin : 'https://youth-rent-24.pages.dev';
---

<Layout
  title="청년월세24 - 전국 지자체별 청년 월세지원금 계산 및 진단"
  description="전국 시·군·구 청년 월세 지원금 자격 조건, 지원 한도액 모의계산 및 공식 접수처 안내 인덱스입니다."
  canonical={`${siteUrl}/`}
  hasAds={false}
>
  <main class="home-container">
    <header class="hero">
      <h1>전국 청년 월세 지원금 진단기</h1>
      <p>거주하는 지역을 선택하면 자격 요건과 12개월간 수령 가능한 예상 지원금을 즉시 계산합니다.</p>
    </header>

    <div class="grid-list">
      {regionsData.map((item) => (
        <a href={`/${item.slug}/`} class="card">
          <h2>{item.name}</h2>
          <p>월 최대 {item.monthlyLimit.toLocaleString()}원 지원</p>
          <span class="btn">모의계산 하기 &rarr;</span>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  .home-container { max-width: 860px; margin: 0 auto; padding: 3rem 1rem; }
  .hero { text-align: center; margin-bottom: 3rem; }
  .hero h1 { font-size: 2.2rem; margin-bottom: 0.5rem; }
  .hero p { color: #9CA3AF; }
  .grid-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1.2rem; }
  .card {
    background: #111827;
    border: 1px solid #1F2937;
    padding: 1.5rem;
    border-radius: 8px;
    display: block;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .card:hover { transform: translateY(-3px); border-color: #10B981; }
  .card h2 { margin: 0 0 0.5rem; font-size: 1.2rem; color: #fff; }
  .card p { margin: 0 0 1rem; font-size: 0.85rem; color: #9CA3AF; }
  .card .btn { font-size: 0.85rem; color: #10B981; font-weight: 600; }
</style>
