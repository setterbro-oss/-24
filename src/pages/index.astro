---
import Layout from '../layouts/Layout.astro';
import national from '../data/national.json';
import regions from '../data/regions.json';
import { isGuideIndexable, isRegionIndexable, isHomeIndexable } from '../lib/indexing.mjs';

const homeIndexable = isHomeIndexable(national, regions);
---
<Layout
  title="청년월세24 | 청년 월세지원 가이드와 계산기"
  description="국토교통부 청년월세 지원과 서울시 등 지자체 사업의 대상·소득 기준·신청 방법을 공식 공고 기준으로 정리하고, 기본 요건 자가진단과 월세 계산기를 제공합니다."
  path="/"
  noindex={!homeIndexable}
>
  <main id="main-content" class="home-container">
    <header class="hero">
      <p class="eyebrow">청년 주거지원 정보 도구</p>
      <h1>청년 월세지원, 기준부터 신청까지</h1>
      <p>전국 공통 사업과 지자체 사업의 차이를 비교하고, 기본 요건 자가진단과 월세 계산기로 나에게 해당하는지 먼저 확인해 보세요. 모든 결과는 참고용이며 실제 자격과 지급 여부는 공식 공고가 기준입니다.</p>
    </header>

    <div class="hero-actions" aria-label="주요 도구">
      <a class="primary-action" href="/guide/#check-title">지원 자격 간이 확인</a>
      <a class="secondary-action" href="/guide/#calc-title">월세 계산기</a>
    </div>

    <section aria-labelledby="start-title">
      <h2 id="start-title">먼저 확인하세요</h2>
      <div class="grid-list">
        <article class="card featured">
          <span class={`list-badge ${isGuideIndexable(national) ? 'verified' : ''}`}>{isGuideIndexable(national) ? '출처 확인 완료' : '출처 확인 필요'}</span>
          <h3><a class="card-title-link" href="/guide/">{national.name}</a></h3>
          <p>{national.description}</p>
          <span class="card-link" aria-hidden="true">가이드 보기 →</span>
        </article>
      </div>
    </section>

    <section aria-labelledby="regions-title">
      <h2 id="regions-title">지자체별 정보</h2>
      <p class="section-desc">전국 공통 기준과 다른 점이 있는 지자체만 별도 페이지로 정리합니다. 지역 페이지는 공식 공고에서 확인된 내용만 담습니다.</p>
      <div class="grid-list">
        {regions.map((region) => (
          <article class="card">
            <span class={`list-badge ${isRegionIndexable(region) ? 'verified' : ''}`}>{isRegionIndexable(region) ? '출처 확인 완료' : '출처 확인 필요'}</span>
            <h3><a class="card-title-link" href={`/${region.slug}/`}>{region.name}</a></h3>
            <p>{region.description}</p>
            <span class="card-link" aria-hidden="true">자세히 보기 →</span>
          </article>
        ))}
      </div>
    </section>

    <section class="howto">
      <h2>지원 신청 전 체크리스트</h2>
      <ol>
        <li>복지로·마이홈포털·해당 지자체의 최신 공식 공고를 확인합니다.</li>
        <li>연령, 거주, 임대차, 소득·재산 및 중복 지원 요건을 확인합니다.</li>
        <li>신청 기간과 필수 서류, 온라인·방문 접수처를 확인합니다.</li>
        <li>불일치하거나 오래된 정보는 문의 페이지를 통해 정정을 요청합니다.</li>
      </ol>
    </section>
  </main>
</Layout>
<style>
  .hero { max-width: 780px; margin: 0 auto 1.25rem; text-align: center; }
  .hero h1 { margin-bottom: .8rem; }
  .hero p { font-size: 1.05rem; }
  .hero-actions { display: flex; justify-content: center; flex-wrap: wrap; gap: .75rem; margin: 1.25rem 0 2.5rem; }
  .hero-actions a { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: .7rem 1.2rem; border-radius: 10px; font-weight: 750; text-decoration: none; }
  .primary-action, .primary-action:visited { color: #fff; background: #1d4ed8; border: 1px solid #1d4ed8; }
  .primary-action:hover { color: #fff; background: #1e40af; }
  .secondary-action, .secondary-action:visited { color: #1d4ed8; background: #fff; border: 1px solid #bfdbfe; }
  .secondary-action:hover { color: #1e40af; background: #eff6ff; }
  .section-desc { color: var(--muted); margin-top: -.3rem; }
  section { margin-bottom: 2.25rem; }
  section > h2 { margin-top: 0; }
  .grid-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 1rem; }
  .card { position: relative; display: flex; flex-direction: column; gap: .7rem; min-height: 200px; padding: 1.3rem; border: 1px solid #dbe3ee; border-radius: 14px; background: #ffffff; color: #263449; box-shadow: 0 1px 3px rgb(15 23 42 / 4%); }
  .card:hover, .card:focus-within { border-color: #93c5fd; background: #f0f7ff; }
  .card.featured { border-color: #93c5fd; }
  .card h3 { margin: 0; color: #111827; font-size: 1.2rem; }
  .card-title-link { position: static; color: #1d4ed8; text-decoration: none; }
  .card-title-link:visited { color: #1d4ed8; }
  .card-title-link::after { content: ""; position: absolute; inset: 0; border-radius: 14px; }
  .card-title-link:hover { color: #1e40af; text-decoration: underline; text-underline-offset: .2em; }
  .card-title-link:focus-visible { outline: 3px solid #b45309; outline-offset: 3px; }
  .card p { margin: 0; color: #475569; font-size: .98rem; }
  .list-badge { align-self: flex-start; padding: .2rem .55rem; border-radius: 6px; background: #eff6ff; color: #1e40af; font-size: .82rem; font-weight: 700; }
  .list-badge.verified { background: #dcfce7; color: #166534; }
  .card-link { margin-top: auto; padding-top: .4rem; color: #1d4ed8; font-weight: 750; }
  .howto { margin-top: 2.5rem; padding: 1.4rem 1.5rem; border: 1px solid var(--border); border-radius: 14px; background: #fff; }
  .howto h2 { margin-top: 0; }
  .howto ol { margin: 0; }
</style>
