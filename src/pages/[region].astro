---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import AdSlot from '../components/AdSlot.astro';
import regions from '../data/regions.json';
import { isGuideIndexable, isRegionIndexable, getVerifiedClaim } from '../lib/indexing.mjs';
import national from '../data/national.json';

export function getStaticPaths() {
  return regions.map((region) => ({ params: { region: region.slug }, props: { region } }));
}

const { region } = Astro.props;
const indexable = isRegionIndexable(region);
const monthlyLimitClaim = getVerifiedClaim(region, 'monthly_limit_krw');
const maxMonthsClaim = getVerifiedClaim(region, 'max_months');
const origin = Astro.site.origin;
const title = `${region.name} 청년 월세지원 정보 | 청년월세24`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: region.name, item: `${origin}/${region.slug}/` },
  ],
};
---
<Layout title={title} description={region.description} path={`/${region.slug}/`} noindex={!indexable} jsonLd={jsonLd} hasAds={indexable}>
  <main id="main-content" class="region-container">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true"> / </span><span>{region.name}</span></nav>
    <header class="hero">
      <p class="eyebrow">지자체별 주거지원 정보</p>
      <h1>{region.name} 청년 월세지원 정보</h1>
      <p>{region.description}</p>
    </header>

    {!indexable && (
      <aside class="verification-warning" role="status">
        <strong>공식 공고 확인 안내</strong>
        <p>이 지역의 세부 내용은 현재 검색 노출 기준을 충족하지 않아 검색·광고 목록에서 제외되어 있습니다. 최신 조건은 아래 공식 원문에서 직접 확인하세요.</p>
      </aside>
    )}

    {indexable && <section class="info-card" aria-labelledby="summary-title">
      <h2 id="summary-title">핵심 내용</h2>
      {region.body.map((p) => <p>{p}</p>)}
    </section>}

    {indexable && <section class="info-card" aria-labelledby="facts-title">
      <h2 id="facts-title">공고에 적힌 주요 항목</h2>
      <dl>
        {region.facts.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      <p class="source-note">
        {indexable ? `공식 출처 대조 완료 · 확인일 ${region.verifiedAt}` : '공식 원문 확인 안내'}
      </p>
    </section>}

    {indexable && region.comparison && (
      <section class="info-card" aria-labelledby="cmp-title">
        <h2 id="cmp-title">국토교통부 사업과 비교</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th scope="col">항목</th><th scope="col">국토교통부 청년월세</th><th scope="col">{region.name}</th></tr>
            </thead>
            <tbody>
              {region.comparison.map((row) => (
                <tr><th scope="row">{row.label}</th><td>{row.national}</td><td>{row.local}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        {isGuideIndexable(national) && <p class="source-note">전국 사업 상세는 <a href="/guide/">청년월세 가이드</a>에서 확인하세요.</p>}
      </section>
    )}

    {indexable && monthlyLimitClaim && maxMonthsClaim && <Calculator title={`${region.name} 월세 계산`} monthlyLimit={Number(monthlyLimitClaim.value)} maxMonths={Number(maxMonthsClaim.value)} />}

    {indexable && <AdSlot slot="content" label="본문 중간 광고" />}

    <section class="apply-card" aria-labelledby="src-title">
      <h2 id="src-title">공식 출처</h2>
      <p><a href={region.sourceUrl} target="_blank" rel="noopener noreferrer">{region.sourceTitle} ↗</a></p>
      <p><a href={region.applyUrl} target="_blank" rel="noopener noreferrer">신청·안내 사이트 바로가기 ↗</a></p>
      {region.verifiedAt && <p class="source-note">자료 확인일: {region.verifiedAt}</p>}
      <p class="source-note">공고 내용은 바뀔 수 있습니다. 신청 전에 반드시 최신 공고 원문을 확인하세요.</p>
    </section>

    <p class="back-link"><a href="/">← 홈으로 돌아가기</a></p>
  </main>
</Layout>
<style>
  .hero h1 { margin-bottom: 1rem; }
</style>
