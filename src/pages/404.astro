---
import Layout from '../layouts/Layout.astro';
const siteUrl = Astro.site?.origin ?? 'https://youth-rent-24.pages.dev';
---
<Layout title="페이지를 찾을 수 없습니다 | 청년월세24" description="요청한 페이지를 찾을 수 없습니다." canonical={`${siteUrl}/404/`} noindex={true}>
  <main id="main-content" style="max-width:800px;margin:0 auto;padding:4rem 1rem;">
    <h1>페이지를 찾을 수 없습니다 (404)</h1>
    <p>주소가 변경되었거나 존재하지 않는 페이지입니다.</p>
    <p><a href="/">홈으로 돌아가기</a></p>
  </main>
</Layout>
