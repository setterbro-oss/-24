---
import Layout from '../layouts/Layout.astro';
import Calculator from '../components/Calculator.astro';
import EligibilityCheck from '../components/EligibilityCheck.astro';
import AdSlot from '../components/AdSlot.astro';
import national from '../data/national.json';
import regions from '../data/regions.json';
import { isGuideIndexable, isRegionIndexable, getVerifiedClaim } from '../lib/indexing.mjs';

const indexable = isGuideIndexable(national);
const monthlyLimitClaim = getVerifiedClaim(national, 'monthly_limit_krw');
const maxMonthsClaim = getVerifiedClaim(national, 'max_months');
const birthMinClaim = getVerifiedClaim(national, 'birth_year_min');
const birthMaxClaim = getVerifiedClaim(national, 'birth_year_max');
const incomeLimitClaim = getVerifiedClaim(national, 'income_limit_1p_krw');
const hasCalculatorClaims = monthlyLimitClaim && maxMonthsClaim;
const hasEligibilityClaims = birthMinClaim && birthMaxClaim && incomeLimitClaim;
const origin = Astro.site.origin;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '홈', item: `${origin}/` },
    { '@type': 'ListItem', position: 2, name: national.name, item: `${origin}/guide/` },
  ],
};
---
<Layout
  title="국토교통부 청년월세 지원 가이드 | 대상·금액·신청방법 | 청년월세24"
  description="청년월세 지원사업의 공식 공고 원문, 신청 안내와 검증 기준을 확인할 수 있는 독립 정보 서비스입니다."
  path="/guide/"
  noindex={!indexable}
  jsonLd={jsonLd}
  hasAds={indexable}
>
  <main id="main-content" class="page">
    <nav class="breadcrumb" aria-label="현재 위치"><a href="/">홈</a><span aria-hidden="true"> / </span><span>청년월세 가이드</span></nav>
    <header class="hero">
      <p class="eyebrow">전국 공통 사업</p>
      <p class="independence-notice">청년월세24는 정부·지자체 공식 사이트가 아닌 독립 정보 서비스이며, 실제 신청·선정은 공식 공고와 심사 결과를 따릅니다.</p>
      <h1>국토교통부 청년월세 지원 가이드</h1>
      <p>{national.description}</p>
    </header>

    <nav aria-label="이 페이지 바로가기">
      <ul class="toc">
        <li><a href="#facts-title">한눈에 보기</a></li>
        {hasEligibilityClaims && <li><a href="#check-title">자가진단</a></li>}
        {hasCalculatorClaims && <li><a href="#calc-title">월세 계산</a></li>}
        {indexable && <li><a href="#apply-title">신청 방법</a></li>}
        {indexable && <li><a href="#faq-title">자주 묻는 질문</a></li>}
      </ul>
    </nav>

    {!indexable && (
      <aside class="verification-warning" role="status">
        <strong>최신 공고를 확인하세요</strong>
        <p>지원 조건과 신청 일정은 공고별로 달라질 수 있습니다. 아래 공식 출처에서 현재 적용되는 공고와 접수 상태를 확인한 뒤 신청하세요.</p>
      </aside>
    )}

    {indexable && <section class="info-card" aria-labelledby="facts-title">
      <h2 id="facts-title">한눈에 보기</h2>
      <dl>
        {national.facts.map((f) => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      <p class="source-note">
        {indexable ? `공식 출처 확인 완료 · 확인일 ${national.verifiedAt}` : '공식 원문에서 최신 조건 확인'}
      </p>
    </section>}

    {indexable && hasEligibilityClaims && <><EligibilityCheck birthYearMin={Number(birthMinClaim.value)} birthYearMax={Number(birthMaxClaim.value)} incomeLimit1p={Number(incomeLimitClaim.value)} /><p class="muted">자가진단 근거: 공식 공고 대조 완료 · {national.verifiedAt}</p></>}

    {indexable && hasCalculatorClaims && <><Calculator title="청년월세 지원 월세 계산" monthlyLimit={Number(monthlyLimitClaim.value)} maxMonths={Number(maxMonthsClaim.value)} /><p class="muted">계산 기준 근거: 공식 공고 대조 완료 · {national.verifiedAt}</p></>}

    {indexable && <AdSlot slot="content" label="본문 중간 광고" />}

    {indexable && <section class="info-card" aria-labelledby="excl-title">
      <h2 id="excl-title">제외 대상</h2>
      <ul>
        {national.exclusions.map((e) => <li>{e}</li>)}
      </ul>
      <p class="muted">보증금·월세 상한 등 주택 요건은 사업 연도별로 달라질 수 있으니 해당 연도 공고에서 확인하세요.</p>
    </section>}

    {indexable && <section class="info-card" aria-labelledby="apply-title">
      <h2 id="apply-title">신청 방법</h2>
      <ol>
        {national.howToApply.map((s) => <li>{s}</li>)}
      </ol>
      <p><a href={national.applyUrl} target="_blank" rel="noopener noreferrer">복지로 바로가기 ↗</a></p>
    </section>}

    {indexable && <section class="info-card" aria-labelledby="local-title">
      <h2 id="local-title">지자체 별도 사업도 확인하세요</h2>
      <p>국토교통부 사업과 별개로 서울시 등 지자체가 자체 청년월세 사업을 운영합니다. 대상 연령과 소득 기준이 달라 한쪽만 해당될 수 있습니다.</p>
      {isRegionIndexable(regions.find((r) => r.slug === 'seoul')) && <p><a href="/seoul/">서울시 청년월세지원과 비교하기 →</a></p>}
    </section>}

    {indexable && <section class="info-card" aria-labelledby="faq-title">
      <h2 id="faq-title">자주 묻는 질문</h2>
      {national.faq.map((item) => (
        <details>
          <summary>{item.q}</summary>
          <p>{item.a}</p>
        </details>
      ))}
    </section>}

    <section class="apply-card" aria-labelledby="src-title">
      <h2 id="src-title">출처</h2>
      <ul>
        {national.sources.map((s) => (
          <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} ↗</a><br /><span class="muted">{s.note}</span></li>
        ))}
      </ul>
      <p class="muted">공고 내용은 바뀔 수 있습니다. 신청 전에 반드시 최신 공고 원문을 확인하세요.</p>
    </section>
  </main>
</Layout>
<style>
  .hero h1 { margin-bottom: 1rem; }
  .independence-notice { display: inline-block; margin: .35rem 0 1rem; padding: .55rem .75rem; border: 1px solid #cbd5e1; border-radius: 8px; background: #f8fafc; color: #334155; font-size: .9rem; }
  .apply-card ul { padding-left: 1.2rem; }
  .apply-card li { margin: .8rem 0; }
</style>
